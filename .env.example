# Set these in Vercel: Project → Settings → Environment Variables. Never commit real values.
RESEND_API_KEY=re_...
TURNSTILE_SECRET_KEY=0x...
UNSUB_SECRET=any-long-random-string
CRON_SECRET=another-long-random-string
RESEND_SEGMENT_ALL=        # from: npm run setup:resend
RESEND_SEGMENT_PENDING=    # from: npm run setup:resend
